#!/usr/bin/env bash
#
# nebula-manager - least-privilege installer/operator for Slack Nebula
# ===================================================================
# Runs as an ordinary user and calls sudo only for the specific actions
# that genuinely need root (writing /etc/nebula, systemd control, ...).
#
#   nebula-manager                       interactive TUI
#   nebula-manager --help                usage
#   nebula-manager ca --name acme        create a CA (unprivileged)
#   nebula-manager sign --name host1 --ip 10.42.0.2/24
#   nebula-manager cert list | expiry | bundle <name>
#   nebula-manager bench server|client ...
#   nebula-manager diag                  diagnostics viewer
#   nebula-manager paths                 show resolved config/keys dirs
#
# See README.md for full usage.

set -o pipefail

###################################################################
########################## Configuration ##########################
###################################################################
MANAGER_VERSION="2.0.0"
# The nebula-manager.conf path is resolved after the modules load by
# resolve_server_conf(): --config / $NEBULA_MANAGER_CONF -> existing /etc
# config -> per-user config. The per-user default avoids needing root on
# first run just to obtain a config.
CONF_OVERRIDE="${SERVER_CONF:-${NEBULA_MANAGER_CONF:-}}"
SERVER_CONF=""
NEBULA_TEMPLATE_URL="https://raw.githubusercontent.com/slackhq/nebula/refs/heads/master/examples/config.yml"
NEBULA_API_RELEASES_URL="https://api.github.com/repos/slackhq/nebula/releases/latest"
MENU_PATH="Main Menu"
VERSION_CACHE_TTL_SECONDS=$((6 * 3600))
# SERVER_CONF_URL / SCRIPT_URL / VERSION_URL / RELEASE_PAGE / REPO_SLUG and
# VERSION_CACHE_FILE are derived from our source repo at runtime by
# init_remote_urls() (after the modules load), so forks check themselves
# instead of always checking upstream. Override with NEBULA_MANAGER_REPO.
MANAGER_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
AUTO_UPDATE_CMD="$SCRIPT_PATH --auto-update-nebula"
CRON_COMMENT="# Auto-update Nebula"

# Runtime defaults (overridable by nebula-manager.conf [global])
: "${NEBULA_BIN_PATH:=/usr/local/bin}"
: "${NEBULA_CERT_FOLDER:=certs}"
: "${USE_COLOR:=true}"
: "${USE_ICONS:=true}"
# Fallback Nebula listen port (used when config.yml has `listen.port: 0`).
: "${NEBULA_DEFAULT_PORT:=4242}"

###################################################################
########################## Load modules ############################
###################################################################
resolve_lib_dir() {
    if [[ -n "${NEBULA_MANAGER_LIB:-}" && -d "${NEBULA_MANAGER_LIB}" ]]; then
        printf '%s\n' "$NEBULA_MANAGER_LIB"; return 0
    fi
    local d
    for d in \
        "$MANAGER_ROOT/lib" \
        "${NEBULA_MANAGER_LIB_BASE:+$NEBULA_MANAGER_LIB_BASE/lib}" \
        /usr/local/lib/nebula-manager/lib \
        /usr/lib/nebula-manager/lib \
        /usr/local/share/nebula-manager/lib
    do
        [[ -n "$d" && -d "$d" ]] && { printf '%s\n' "$d"; return 0; }
    done
    printf '%s\n' "$MANAGER_ROOT/lib"
}

MANAGER_LIB_DIR="$(resolve_lib_dir)"
for _mod in ui pki bench system import; do
    if [[ -r "$MANAGER_LIB_DIR/$_mod.sh" ]]; then
        # shellcheck source=/dev/null
        source "$MANAGER_LIB_DIR/$_mod.sh"
    else
        echo "nebula-manager: missing module: $MANAGER_LIB_DIR/$_mod.sh" >&2
        exit 1
    fi
done
unset _mod

# Resolve the repo this copy came from (env override -> git origin -> upstream)
# and derive the URLs used for config templates, version checks and updates.
init_remote_urls

###################################################################
############################## TUI #################################
###################################################################

top_header() {
    echo -e "$(show_status 'success') ${BOLD}${YELLOW}Server:${RESET} \e[38;5;$(hash_color_256 "$SERVER_NAME")m$SERVER_NAME${RESET}"
    if check_nebula_installed; then
        LATEST_VERSION=$(get_latest_version)
        echo -e "$(show_status 'success') ${BOLD}${YELLOW}Nebula:${RESET} v$NEBULA_VERSION$([ "$NEBULA_VERSION" != "$LATEST_VERSION" ] && echo -e "${GREEN} ➜ ${RED}Update Available:${RESET} v$LATEST_VERSION${RESET}" || echo -e " ${GREEN}(Up to date)${RESET}")"
        if [[ "$NEBULA_VERSION" != "$LATEST_VERSION" && "${IGNORE_NEBULA_UPDATE:-}" != "true" ]]; then
            check_for_nebula_update
        fi
        show_system_info
    else
        echo -e "$(show_status 'error') Nebula not installed..."
    fi
}

nebula_maintenance() {
    dynamic_menu_title=("$MENU_PATH" "Maintenance")
    dynamic_menu_options=("$(get_icon 'start')Toggle Nebula Service" "$(get_icon 'download')Update Nebula" "$(get_icon 'schedule')Auto-Update Scheduler" "$(get_icon 'install')Install Script to System" "$(get_icon 'uninstall')${ORANGE}Remove Nebula${RESET}")
    dynamic_menu_functions=("toggle_nebula_service" "check_for_nebula_update" "auto_update_cron_menu" "ensure_installed_to_bin_path" "remove_nebula")
    dynamic_menu dynamic_menu_title dynamic_menu_options dynamic_menu_functions 1
}

# --- TUI glue for the CLI capabilities (Servers / Setup / Diagnostics) --------
# Show the refreshed header after diagnostics: this is the explicit action that
# reads a service-owned config (with temporary sudo) and caches the values.
run_diagnostics_tui() { diagnostics_view; echo; show_system_info; }

server_add_tui() {
    local name dir service role host enabled
    name="$(ui_input "Add Server" "Server name (e.g. edge-1):")" || return
    [[ -z "$name" ]] && return
    dir="$(ui_input "Add Server" "Nebula dir:" "/etc/nebula/${name}")"
    service="$(ui_input "Add Server" "systemd unit:" "nebula-${name}.service")"
    role="$(ui_input "Add Server" "Role (client|lighthouse):" "client")"
    host="$(ui_input "Add Server" "Public host:port (lighthouse; optional):" "")"
    if ui_yesno "Add Server" "Enable '$name' for batch operations?"; then enabled=true; else enabled=false; fi
    SERVER_CONF="$(resolve_server_conf)"
    server_add_entry "$name" "$dir" "$service" "$enabled" "$role" "$host"
}

server_toggle_tui() {
    server_list
    local name
    name="$(ui_input "Enable/Disable" "Server name:")" || return
    [[ -z "$name" ]] && return
    if ui_yesno "Enable/Disable" "Enable '$name'? (No disables it)"; then
        server_set_enabled "$name" true
    else
        server_set_enabled "$name" false
    fi
}

server_remove_tui() {
    server_list
    local name
    name="$(ui_input "Remove Server" "Server name to remove:")" || return
    [[ -z "$name" ]] && return
    ui_yesno "Remove Server" "Remove [$name] from nebula-manager.conf?" && server_remove_entry "$name"
}

server_menu() {
    SERVER_CONF="$(resolve_server_conf)"
    dynamic_menu_title=("$MENU_PATH" "Servers")
    dynamic_menu_options=("$(get_icon 'list')List Servers" "$(get_icon 'create')Add Server" "$(get_icon 'edit')Enable / Disable Server" "$(get_icon 'delete')Remove Server")
    dynamic_menu_functions=("server_list" "server_add_tui" "server_toggle_tui" "server_remove_tui")
    dynamic_menu dynamic_menu_title dynamic_menu_options dynamic_menu_functions 1
}

config_init_tui() {
    SERVER_CONF="$(resolve_server_conf)"
    if [[ -f "$SERVER_CONF" ]] && ! ui_yesno "Create config" "$SERVER_CONF already exists.\nOverwrite it with the bundled template?"; then
        log_info "Kept the existing config."
        return 0
    fi
    install_config_template "$SERVER_CONF" --force
}
config_edit_tui() {
    SERVER_CONF="$(resolve_server_conf)"
    if [[ ! -f "$SERVER_CONF" ]]; then
        log_warn "No config to edit yet: $SERVER_CONF"
        log_info "Use 'Import / update' or 'Create config' first."
        return 1
    fi
    config_cli edit
}
config_delete_tui() {
    SERVER_CONF="$(resolve_server_conf)"
    if [[ ! -f "$SERVER_CONF" ]]; then
        log_warn "No configuration to delete at $SERVER_CONF"
        return 0
    fi
    if ui_yesno "Delete config" "Delete $SERVER_CONF?\nThis cannot be undone."; then
        config_remove_cli --force
    else
        log_info "Aborted."
    fi
}
config_browse_tui() {
    local picked
    picked="$(ui_fselect "Select nebula-manager.conf" "Pick an existing nebula-manager.conf" "${HOME:-$PWD}")" || return 0
    [[ -n "$picked" && -f "$picked" ]] || { log_error "No config file selected."; return 1; }
    config_use_file "$picked"
}

# Ask the TUI to start over from the top (re-detect config/server). The flag is
# consumed by tui_main(); nested menus just unwind when they see it set.
tui_reload_request() { TUI_RESTART=1; }

# Build the Setup menu. In 'bootstrap' mode it is the top-level screen shown on
# first run (no Back button, adds Exit); otherwise it is reached from the main
# menu (dynamic_menu appends Back at depth>0).
_setup_menu_build() {
    local bootstrap="${1:-0}"
    _SETUP_OPTS=(
        "$(get_icon 'download')Import / update from this host"
        "$(get_icon 'upload')Import client bundle (.zip/.tar.gz)"
        "$(get_icon 'create')Create config from template"
        "$(get_icon 'inspect')Browse for a config file"
        "$(get_icon 'edit')Edit config"
        "$(get_icon 'delete')Delete config"
        "$(get_icon 'list')Manage servers"
        "$(get_icon 'keys')Certificate workspace"
        "$(get_icon 'refresh')Reload & continue"
    )
    _SETUP_FNS=(
        import_run
        import_bundle_tui
        config_init_tui
        config_browse_tui
        config_edit_tui
        config_delete_tui
        server_menu
        select_cert_workspace
        tui_reload_request
    )
    if (( bootstrap )); then
        _SETUP_OPTS+=( "$(get_icon 'exit')${BOLD}Exit${RESET}" )
        _SETUP_FNS+=( exit )
    fi
}

# Runs before every Setup redraw: rebuilds the items and refreshes the status
# line shown inside the box (what was detected on this host).
_setup_menu_refresh() {
    _setup_menu_build "${SETUP_MENU_BOOTSTRAP:-0}"
    DYNAMIC_MENU_PROMPT="$(NEBULA_NO_PROMPT=1 setup_state_summary)"
}

setup_menu() {
    SETUP_MENU_BOOTSTRAP=0
    _setup_menu_build 0
    dynamic_menu_title=("$MENU_PATH" "Setup")
    dynamic_menu dynamic_menu_title _SETUP_OPTS _SETUP_FNS 1 _setup_menu_refresh
    unset SETUP_MENU_BOOTSTRAP
}

bootstrap_menu() {
    SETUP_MENU_BOOTSTRAP=1
    _setup_menu_build 1
    dynamic_menu_title=("$MENU_PATH" "Setup")
    dynamic_menu dynamic_menu_title _SETUP_OPTS _SETUP_FNS 0 _setup_menu_refresh
    unset SETUP_MENU_BOOTSTRAP
}

main_menu() {
    if check_nebula_installed; then
        if ! check_nebula_service; then
            setup_nebula_service
        fi
        if [ ! -f "${NEBULA_DIR}/config.yml" ]; then
            setup_nebula_config
        fi
        menu_options=("$(get_icon 'certificate')Certificates" "$(get_icon 'list')Servers" "$(get_icon 'configuration')Configuration" "$(get_icon 'connectivity')Connectivity" "$(get_icon 'scan')Diagnostics" "$(get_icon 'bench')Benchmarks" "$(get_icon 'download')Setup" "$(get_icon 'maintenance')Maintenance" "$(get_icon 'exit')${BOLD}Exit${RESET}")
        menu_option_functions=("manage_nebula_certs" "server_menu" "manage_configuration" "check_node_connectivity" "run_diagnostics_tui" "run_benchmark" "setup_menu" "nebula_maintenance" "exit")
    else
        menu_options=("$(get_icon 'install')Install Nebula" "$(get_icon 'list')Servers" "$(get_icon 'download')Setup" "$(get_icon 'exit')${BOLD}Exit${RESET}")
        menu_option_functions=("install_nebula" "server_menu" "setup_menu" "exit")
    fi
    menu_title=("$MENU_PATH")
    dynamic_menu menu_title menu_options menu_option_functions 0
}

tui_main() {
    TUI_RESTART=0
    while true; do
        rm -f /tmp/nebula_failed_*
        ui_clear
        load_global_config
        check_dependencies || exit 1
        banner
        check_script_update
        if select_nebula_server; then
            # Offer a certificate workspace if none is known yet (first run).
            first_run_workspace_setup
            if ui_clear_enabled; then banner; fi
            top_header
            main_menu
        else
            log_info "No usable server selected - opening Setup (import from this host, import a client bundle, create or browse for a config)."
            bootstrap_menu
        fi
        # 'Reload & continue' sets TUI_RESTART so the whole flow starts over with
        # freshly detected state; pressing Back/Cancel simply exits the loop.
        [[ "${TUI_RESTART:-0}" == 1 ]] || break
        TUI_RESTART=0
    done
}

###################################################################
############################# CLI #################################
###################################################################

usage() {
    cat <<EOF
Nebula Manager v$MANAGER_VERSION

Usage: nebula-manager [global options] [command] [command options]

Runs as a normal user; sudo is requested only for privileged actions.

Global options:
  --config <path>       Path to nebula-manager.conf   (default: $SERVER_CONF)
  --cert-dir <path>     Certificate workspace directory (overrides everything)
  --keys-dir <path>     Alias for NEBULA_KEYS_DIR (certificate workspace)
  --ui <backend>        UI backend: auto|plain|whiptail|dialog (auto = plain menus)
  --debug <levels>      Debug mode: warn|log|info|learn|all (comma-separated)
                        learn prints every Nebula CLI command before running it
  -l, --learn           Shorthand for --debug=learn
  --clear-screen        Clear the screen between TUI redraws (default: keep transcript)
  --no-clear-screen     Keep the transcript (default)
  --no-color            Disable colored output
  -v, --version         Print version
  -h, --help            Show this help

Commands:
  (none)                          Interactive TUI (menu-driven)
  ca [create] --name NAME [...]   Create a certificate authority (unprivileged)
  sign [--name N] [--ip CIDR] [--in-pub KEY.pub] [--qr OUT.png] [...]
                                  Sign a client cert (name/IP auto-suggested;
                                  --in-pub for mobile: the key stays on the device)
  cert list|expiry|remove          Certificate operations
  cert bundle|export [NAME] [--out DIR]
                                  Export a client zip (NAME may be a unique
                                  substring; omit it to list candidates).
                                  Default output: current dir, else ~/Downloads
  bench server|client [...]       iperf3 benchmarks
  diag                            Diagnostics (TUN IP, UDP socket, cert expiry)
  dns status|setup|apply|persist|lighthouse
                                  Nebula DNS: status, interactive setup, apply now,
                                  apply + boot hook, or enable on a lighthouse
  config path|init|refresh|edit|remove   Manage nebula-manager.conf (offline template)
  server add|list|remove|...      Manage [server.*] entries in nebula-manager.conf
  import [--dry-run] [--yes]      Detect a running Nebula and generate nebula-manager.conf
  import --bundle FILE [--dir DIR] [--yes] [--force] [--start]
                                  Install a client bundle (.zip/.tar.gz/.tgz/.tar)
  ui                              Report the selected menu/browse UI backends
  paths                           Print resolved config, key & cache paths
  auto-update                     Update Nebula to the latest release

Environment:
  NEBULA_KEYS_DIR      Certificate workspace (2nd precedence, after --cert-dir)
  NEBULA_BUNDLE_DIR    Default directory for exported client bundles
  NEBULA_LOCAL_CONFIG  Nebula config.yml used to populate client bundles
  NEBULA_NO_LOCAL_CONFIG  Set to 1 to skip auto-detecting that config
  NEBULA_MANAGER_LIB   Override the lib/ directory location
  NEBULA_MANAGER_CONF  Path to nebula-manager.conf (alias for --config)
  NEBULA_MANAGER_REPO  owner/repo to use for update checks (default: git origin)
  NEBULA_MANAGER_REF   branch to use for update checks (default: main)
  NEBULA_UI            UI backend override
  DEBUG                Debug levels: warn|log|info|learn|all
                        (same as --debug; learn shows the Nebula CLI commands)
  NEBULA_CLEAR_SCREEN  Set to 1 to clear between TUI redraws (default: off)

Update checks follow your repo (git origin -> NEBULA_MANAGER_REPO -> upstream).
To check the upstream project explicitly:
  NEBULA_MANAGER_REPO=jordanhillis/nebula-manager nebula-manager
EOF
}

print_paths() {
    printf 'config:    %s\n' "$SERVER_CONF"
    printf 'cert-dir:  %s\n' "$(resolve_cert_dir)"
    printf 'bin-path:  %s\n' "$NEBULA_BIN_PATH"
    printf 'lib-dir:   %s\n' "$MANAGER_LIB_DIR"
    printf 'ui-backend: %s\n' "$(ui_backend)"
    printf 'debug:     %s\n' "${DEBUG:-log}"
    printf 'clear-screen: %s\n' "${NEBULA_CLEAR_SCREEN:-0}"
    printf 'info-cache: %s\n' "$(nebula_info_cache_file)"
    printf 'update-repo: %s@%s\n' "${REPO_SLUG:-jordanhillis/nebula-manager}" "${REPO_REF:-main}"
}

# Consume global flags, leaving the (sub)command + its args in REMAINING_ARGS.
REMAINING_ARGS=()
parse_global_flags() {
    while (($#)); do
        case "$1" in
            --config=*)     CONF_OVERRIDE="${1#*=}" ;;
            --config)       shift; CONF_OVERRIDE="${1:-}" ;;
            --cert-dir=*)   CERT_DIR_OVERRIDE="${1#*=}" ;;
            --cert-dir)     shift; CERT_DIR_OVERRIDE="${1:-}" ;;
            --keys-dir=*)   NEBULA_KEYS_DIR="${1#*=}" ;;
            --keys-dir)     shift; NEBULA_KEYS_DIR="${1:-}" ;;
            --ui=*)         NEBULA_UI="${1#*=}" ;;
            --ui)           shift; NEBULA_UI="${1:-}" ;;
            --debug=*)      DEBUG="${1#*=}" ;;
            --debug)        shift; DEBUG="${1:-all}" ;;
            --learn|-l)     DEBUG=learn ;;
            --clear-screen) NEBULA_CLEAR_SCREEN=1 ;;
            --no-clear-screen) NEBULA_CLEAR_SCREEN=0 ;;
            --no-color)     USE_COLOR=false ;;
            --auto-update-nebula) REMAINING_ARGS+=("auto-update") ;;
            *)              REMAINING_ARGS+=("$1") ;;
        esac
        shift
    done
}

main() {
    parse_global_flags "$@"
    SERVER_CONF="$(resolve_server_conf)"
    set -- ${REMAINING_ARGS[@]+"${REMAINING_ARGS[@]}"}
    local cmd="${1:-}"

    case "$cmd" in
        "" )            tui_main ;;
        -h|--help|help) usage ;;
        -v|--version|version) echo "Nebula Manager v${MANAGER_VERSION}" ;;
        paths)          print_paths ;;
        ca)             shift; pki_ca_cli "$@" ;;
        sign)           shift; pki_sign_cli "$@" ;;
        cert|pki)       shift; pki_cli "$@" ;;
        bench)          shift; bench_cli "$@" ;;
        diag|diagnose)  shift; diag_cli "$@" ;;
        dns)            shift; dns_cli "$@" ;;
        config|conf)    shift; config_cli "$@" ;;
        server|srv)     shift; server_cli "$@" ;;
        import)         shift; import_cli "$@" ;;
        ui)             ui_report ;;
        auto-update)
            load_global_config
            AUTO_UPDATE=true
            banner
            check_nebula_installed
            auto_update_nebula
            ;;
        *) echo "nebula-manager: unknown command '$cmd'" >&2; usage >&2; exit 2 ;;
    esac
}

# Run only when executed directly, so tests can `source` this file to exercise the
# TUI/menu helpers without starting the interactive flow.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
